{
 "cleanUrls": true,
 "trailingSlash": false,
 "rewrites": [
  {
   "source": "/join/:code",
   "destination": "/join/index.html"
  }
 ],
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "Content-Security-Policy",
     "value": "default-src 'none'; img-src 'self'; font-src 'self'; script-src 'self'; connect-src https://hub.plungevr.com; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    },
    {
     "key": "Strict-Transport-Security",
     "value": "max-age=31536000; includeSubDomains"
    },
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "no-referrer"
    },
    {
     "key": "Permissions-Policy",
     "value": "camera=(), microphone=(), geolocation=()"
    }
   ]
  }
 ]
}
